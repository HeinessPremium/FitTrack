# Copy this file to .env.local and fill in your own free-tier values.
# Never commit .env.local — it's already in .gitignore.

# Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Paystack dashboard → Settings → API Keys & Webhooks (use the TEST public key while developing)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
